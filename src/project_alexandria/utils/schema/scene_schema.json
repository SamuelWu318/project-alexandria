{
  "_about": "SINGLE SOURCE OF TRUTH for the scene-record schema. Every store derives its contract from this file: segment.py's blank record, relational.py's SQLite columns/DDL/filters, index.py + search.py's named vectors, and the reconcile tool that ripples edits across scenes JSON + SQLite + Qdrant payloads. The design has THREE query lanes: SEMANTIC (the vector:true fields — summary + descriptors single, svos + subject/verb/object/setting multivector), HARD facets (filterable categoricals: book_id, pov, tense), and SOFT facets (payload scalars re-ranked at read time: prose_register, dialogue_ratio, vdi_curve). There is NO per-field `weight` any more — search tunes with method_weights + the soft-rank knobs (retired per PLAN D3). EDIT THIS FILE to add / rename / drop a field, then run `python -m utils.schema --reconcile` to make every store match. Do NOT hand-edit the derived lists in the store files.",
  "_editing": "Add a field: add an entry under `fields`. Drop a field: delete its entry (reconcile then strips it from every record; a `vector` field also needs a re-index via index.py). `kind:core` fields are structural (ids/positions/prose/provenance) and are protected from reconcile stripping/nulling. `kind:enrichment` fields are the experimental surface. `source` says who fills it: `llm` (enrichment authors it — the drift guard checks these against enrich.SceneEnrichment), `derived` (derive.py computes it from other fields — svos/facets from moments, vdi_curve/prose_register/dialogue_ratio/arc), `segment`/`pipeline`/`derived`-core (structural). Field ORDER here is the SQLite column order. A `vector:true` field is a named Qdrant vector; `multivector:true` (a list field) stores ONE vector PER item and scores by MAX_SIM max-pooling. `type:float` -> SQLite REAL. Changing multivector on/off or the vector set changes the collection config and needs a full re-index (index._ensure_collection rebuilds).",
  "schema_version": 4,
  "primary_key": "scene_id",
  "id_format": "{book_id}-{pos}",
  "indexes": [
    {"name": "ix_nav",    "cols": ["book_id", "pos"], "unique": true},
    {"name": "ix_author", "cols": ["author"]},
    {"name": "ix_lang",   "cols": ["language"]},
    {"name": "ix_pov",    "cols": ["pov"]},
    {"name": "ix_tense",  "cols": ["tense"]},
    {"name": "ix_stitch", "cols": ["stitch_status"]},
    {"name": "ix_enrich", "cols": ["enriched"]}
  ],
  "fields": {
    "scene_id":              {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "book_id":               {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "pos":                   {"kind": "core", "source": "derived", "json": false, "type": "int", "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "pos"}},
    "prev_scene_id":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}},
    "next_scene_id":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}},
    "author":                {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "language":              {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "stitch_status":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "word_count":            {"kind": "core", "source": "segment", "json": true, "type": "int",  "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "direct"}},
    "start_paragraph_index": {"kind": "core", "source": "segment", "json": true, "type": "int",  "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "direct"}},
    "end_paragraph_index":   {"kind": "core", "source": "segment", "json": true, "type": "int",  "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "direct"}},
    "chapter_title":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}},

    "pov":                   {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "POV"},
    "tense":                 {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "Tense"},

    "summary":               {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "vector": true},
    "descriptors":           {"kind": "enrichment", "source": "llm",     "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true},
    "moments":               {"kind": "enrichment", "source": "llm",     "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}},
    "svos":                  {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true},
    "subject":               {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true},
    "verb":                  {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true},
    "object":                {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true},
    "setting":               {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true},

    "prose_word":            {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",   "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "enum": "ProseRegister"},
    "prose_register":        {"kind": "enrichment", "source": "derived", "json": true, "type": "float", "default": null, "sql": {"col": true, "type": "REAL", "store": "float"}},
    "dialogue_ratio":        {"kind": "enrichment", "source": "derived", "json": true, "type": "float", "default": null, "sql": {"col": true, "type": "REAL", "store": "float"}},
    "vdi_curve":             {"kind": "enrichment", "source": "derived", "json": true, "type": "list",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}},
    "arc":                   {"kind": "enrichment", "source": "derived", "json": true, "type": "str",   "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "enum": "Arc"},

    "enriched":              {"kind": "core", "source": "pipeline", "json": true, "type": "bool", "default": false, "sql": {"col": true, "type": "INTEGER", "store": "bool_int"}, "filterable": true},
    "enrich_model":          {"kind": "core", "source": "pipeline", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT", "store": "direct"}},
    "schema_version":        {"kind": "core", "source": "pipeline", "json": true, "type": "int",  "default": "$schema_version", "sql": {"col": true, "type": "TEXT", "store": "direct"}},
    "text_html":             {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": false}},
    "book_metadata":         {"kind": "core", "source": "segment", "json": true, "type": "dict", "default": null,  "sql": {"col": false}}
  }
}
