    "next_scene_id":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}},
    "author":                {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "language":              {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "dominant_tone":         {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "Tone"},
    "prev_tone":             {"kind": "enrichment", "source": "derived", "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "Tone"},
    "next_tone":             {"kind": "enrichment", "source": "derived", "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "Tone"},
    "intensity":             {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "Intensity"},
    "arc":                   {"kind": "enrichment", "source": "llm",     "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "filterable": true, "enum": "Arc"},
    "stitch_status":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}, "filterable": true},
    "word_count":            {"kind": "core", "source": "segment", "json": true, "type": "int",  "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "direct"}},
    "start_paragraph_index": {"kind": "core", "source": "segment", "json": true, "type": "int",  "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "direct"}},
    "end_paragraph_index":   {"kind": "core", "source": "segment", "json": true, "type": "int",  "default": null,  "sql": {"col": true, "type": "INTEGER", "store": "direct"}},
    "scene_title":           {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}},
    "chapter_title":         {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT",    "store": "direct"}},
    "descriptors":           {"kind": "enrichment", "source": "llm", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "weight": 0.25},
    "summary":               {"kind": "enrichment", "source": "llm", "json": true, "type": "str",  "default": null, "sql": {"col": true, "type": "TEXT", "store": "direct"}, "vector": true, "weight": 0.25},
   "moments":               {"kind": "enrichment", "source": "llm", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}},
    "svos":                  {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true, "weight": 0.5},
    "subject":               {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true, "weight": 0.2},
    "verb":                  {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true, "weight": 0.1},
    "object":                {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true, "weight": 0.15},
    "setting":               {"kind": "enrichment", "source": "derived", "json": true, "type": "list", "default": null, "sql": {"col": true, "type": "TEXT", "store": "json"}, "vector": true, "multivector": true, "weight": 0.05},
    "enriched":              {"kind": "core", "source": "pipeline", "json": true, "type": "bool", "default": false, "sql": {"col": true, "type": "INTEGER", "store": "bool_int"}, "filterable": true},
    "enrich_model":          {"kind": "core", "source": "pipeline", "json": true, "type": "str",  "default": null,  "sql": {"col": true, "type": "TEXT", "store": "direct"}},
    "schema_version":        {"kind": "core", "source": "pipeline", "json": true, "type": "int",  "default": "$schema_version", "sql": {"col": true, "type": "TEXT", "store": "direct"}},
    "text_html":             {"kind": "core", "source": "segment", "json": true, "type": "str",  "default": null,  "sql": {"col": false}},
    "book_metadata":         {"kind": "core", "source": "segment", "json": true, "type": "dict", "default": null,  "sql": {"col": false}}
  }
